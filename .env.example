# Copy to .env and fill in. NEVER commit .env. No value below is a working secret.
# Generate 32 random bytes (base64):
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Generate SECRET_KEY:
#   python -c "import secrets;print(secrets.token_hex(32))"

# --- Flask (required unless EHR_DEV_MODE=1) --------------------------------
SECRET_KEY=
DATABASE_URL=sqlite:///ehr.db
# Directory for encrypted uploads (default: /var/lib/ehr/ehr_uploads, or the OS
# temp dir in dev/test mode)
UPLOAD_DIR=
# Secure cookies are ON by default; set to false only for plain-HTTP local dev
SESSION_COOKIE_SECURE=true
# Explicit local-development opt-in: ephemeral keys, insecure cookies allowed.
# Never set this on a shared or internet-facing host.
EHR_DEV_MODE=0

# --- File encryption / anchoring keys (required, base64 of 32 random bytes) -
# FILE_KEK wraps per-file data keys. Losing it makes stored files unreadable.
FILE_KEK=
# Keys the HMAC digest that is anchored on-chain.
ANCHOR_HMAC_KEY=

# --- Rate limiting (F-04: login brute-force protection) ---------------------
# Without this, limits are per-process (memory://) and do not survive restarts
# or span multiple gunicorn workers. Set to a shared Redis instance in production.
RATELIMIT_STORAGE_URI=

# --- Blockchain (optional; without it anchoring is reported as "unavailable")
BLOCKCHAIN_RPC_URL=http://127.0.0.1:7545
# Private key of the contract OPERATOR account (the account that deployed the
# contracts). Use a throwaway local-chain key only. Never a real wallet.
BLOCKCHAIN_OPERATOR_PRIVATE_KEY=
# Directory with Truffle build artifacts (default: build/contracts)
CONTRACT_ARTIFACTS_DIR=build/contracts
# Optional overrides of the addresses found in the artifacts
CONSENT_CONTRACT_ADDRESS=
FILE_VERIFICATION_CONTRACT_ADDRESS=
ERASURE_LOG_CONTRACT_ADDRESS=

# --- IPFS (optional) ---------------------------------------------------------
IPFS_API_URL=http://127.0.0.1:5001

# --- Dev server (python run.py) ---------------------------------------------
# Bind address and debug are opt-in; the defaults are 127.0.0.1 and off.
# FLASK_RUN_HOST=127.0.0.1
# PORT=5002
# FLASK_DEBUG=0
